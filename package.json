{
  "name": "teach-arcade",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-question-bank.mjs && node scripts/build-cabinet-catalog.mjs && node scripts/build-resource-cards.mjs && node scripts/check-crossword-assets.mjs && node scripts/sync-interactive-content.mjs && node scripts/normalize-seo-host.mjs && node scripts/generate-sitemap.mjs && node scripts/build-search-index.mjs && node scripts/generate-robots.mjs && echo 'static site'",
    "audit": "node scripts/audit-site.mjs",
    "test:territory": "node scripts/test-territory-takedown.mjs && node scripts/test-territory-layered.mjs",
    "test:question-bank": "node scripts/test-question-bank.mjs",
    "test:question-bank:ela": "node scripts/test-ela-question-bank.mjs",
    "test:search": "node scripts/test-search.mjs",
    "build:crosswords": "python3 scripts/build-crosswords.py && python3 scripts/render-crossword-library.py",
    "test:crosswords": "node scripts/check-crossword-assets.mjs && python3 scripts/validate-crosswords.py",
    "test:science-lab": "node scripts/test-science-lab.mjs",
    "dev:midway": "node lib/multiplayer/serve.js",
    "test:midway": "node tests/midway-classroom.mjs",
    "build:cards": "node scripts/build-cabinet-catalog.mjs && node scripts/build-resource-cards.mjs"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "parse5": "7.3.0"
  }
}
